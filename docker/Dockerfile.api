# VoltVision AI — API Dockerfile
# Build: docker build -t voltvision-api -f docker/Dockerfile.api .
# Run:   docker run -p 8000:8000 --env-file .env voltvision-api

FROM python:3.11-slim

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libssl-dev curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first (layer cache)
COPY requirements.txt .
RUN pip install --no-cache-dir \
    fastapi==0.111.0 \
    "uvicorn[standard]==0.29.0" \
    "python-jose[cryptography]==3.3.0" \
    "passlib[bcrypt]==1.7.4" \
    "pydantic[email]==2.7.1" \
    pydantic-settings==2.2.1 \
    python-multipart==0.0.9 \
    influxdb-client==1.42.0 \
    paho-mqtt==1.6.1 \
    scikit-learn==1.4.2 \
    numpy==1.26.4 \
    pandas==2.2.2 \
    email-validator

# Copy source
COPY . .

# Create necessary dirs
RUN mkdir -p db ai_models dashboard

# Non-root user
RUN useradd -m voltarax && chown -R voltarax:voltarax /app
USER voltarax

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
